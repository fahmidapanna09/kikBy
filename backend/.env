# Copy to .env and fill in. Never commit the real .env file.

APP_ENV=local
HTTP_PORT=8080

# When running via docker-compose, these two are overridden by the compose
# file itself; set them here only for running `go run ./cmd/api` on the host.
POSTGRES_DSN=postgres://chatapp:chatapp_dev_password@localhost:5432/chatapp?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false # set true against ElastiCache with transit encryption (terraform/elasticache.tf)

# Generate real random secrets for anything beyond local dev, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-32bytesmin
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32bytesmin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_PER_PHONE_10M=3
OTP_MAX_PER_IP_10M=10

# "console" = no real SMS sent, use the local debug flow to test
SMS_PROVIDER=console
SMS_API_KEY=

# S3-compatible object storage (MinIO locally, via docker-compose). Endpoint
# is what the backend itself uses (reachable inside the docker network);
# PRESIGN_ENDPOINT is baked into the presigned URLs handed to clients and
# must be reachable *from wherever the client runs*:
#   - curl/Postman from your host machine: http://localhost:9000
#   - Android emulator:                     http://10.0.2.2:9000
#   - a real device on the same network:    http://<your-machine-lan-ip>:9000
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=chatapp-media
S3_ACCESS_KEY_ID=chatapp_minio
S3_SECRET_ACCESS_KEY=chatapp_minio_password
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL=15m

MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_AUDIO_BYTES=26214400
MEDIA_MAX_DOCUMENT_BYTES=104857600

# Gemini AI agent (Phase 9). Get a key from https://aistudio.google.com/apikey.
# Leave empty to run everything else — only POST .../ai/conversations/{id}/messages
# needs it, and it fails loudly (never silently) when it's missing.
# NEVER commit a real key here or anywhere in version control — this file is
# the template; put real values only in your local .env, which is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# --- E-mail (password reset + e-mail verification) via Resend ---
# Create a key at https://resend.com/api-keys and verify your sending domain at https://resend.com/domains.
# Without a verified domain Resend only delivers from onboarding@resend.dev to YOUR OWN Resend account e-mail.
# With no key: APP_ENV=local logs the links to the console; any other env fails loudly.
RESEND_API_KEY=
MAIL_FROM=KikBite <kikbite@verify.2fauth.online>
# Where the web app lives; the e-mailed links point here (/reset-password, /verify-email)
APP_BASE_URL=http://localhost:4173

# Resend webhooks (optional): bounces/complaints put the address on a suppression list. Secret = "whsec_..." from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
