resource "aws_ecr_repository" "api" {
  name                 = "chatplatform-api"
  image_tag_mutability = "IMMUTABLE" # a tag, once pushed, always means the same image — "latest" floating tags make rollback a guess

  image_scanning_configuration {
    scan_on_push = true
  }
}

resource "aws_ecr_lifecycle_policy" "api" {
  repository = aws_ecr_repository.api.name
  policy = jsonencode({
    rules = [{
      rulePriority = 1
      description  = "keep the last 20 images, expire the rest"
      selection = {
        tagStatus   = "any"
        countType   = "imageCountMoreThan"
        countNumber = 20
      }
      action = { type = "expire" }
    }]
  })
}
